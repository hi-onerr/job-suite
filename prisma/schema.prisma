// Phase 0 schema — see PHASE0-PLAN.md §3
// Dev uses SQLite; switch provider to "postgresql" before deploying for the group.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── App models ───────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  password      String?             // null for OAuth-only users
  profileText   String? // was localStorage "user-profile"
  profileStructured String? // AI-parsed CV as JSON string (Gemini)
  aiModelPref   String?  @default("auto") // "auto" | "gemini" | "groq"
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  accounts        Account[]
  sessions        Session[]
  apiKeys         ApiKey[]
  applications    Application[]
  cvVersions      CvVersion[]
  passwordResets  PasswordReset[]
  createdAt       DateTime      @default(now())
}

model ApiKey {
  id         String @id @default(cuid())
  userId     String
  provider   String // "gemini" | "anthropic" | "openai"
  ciphertext String // AES-256-GCM encrypted key
  iv         String
  authTag    String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Application {
  id            String   @id @default(cuid())
  userId        String
  company       String
  role          String
  location      String?
  url           String?
  jobDesc       String
  status        String   @default("saved") // saved|applied|interview|offer|rejected
  matchScore    Int      @default(0)
  analysis      String? // AI analysis JSON (strengths, gaps, recommendation, salaryRange)
  documents     String? // generated docs JSON: [{ type, content, createdAt }] (latest per type)
  prep          String? // cached interview-prep JSON (company overview, salary, questions)
  appliedDate   String?
  deadline      String?
  notes         String?
  salary        String?
  cvVersionId   String? // which CvVersion was used to generate docs for this application
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CvVersion {
  id                String   @id @default(cuid())
  userId            String
  name              String   // e.g. "Banking CV", "Supply Chain CV"
  sectors           String   @default("[]") // JSON string: ["finance","banking","risk"]
  profileText       String
  profileStructured String?  // AI-parsed JSON, populated on demand
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Auth.js (NextAuth) standard models ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimit {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
}

model UsedOtp {
  id        String   @id  // "{userId}:{code}:{windowTs}"
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
